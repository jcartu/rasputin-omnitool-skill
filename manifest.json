{
  "schema_version": "2026.4",
  "name": "rasputin-omnitool-skill",
  "version": "0.4.0",
  "tools": [
    {
      "name": "browser",
      "version": "0.4.0",
      "description": "Operate a browser via Playwright MCP.",
      "inputs": {
        "action": {
          "type": "string",
          "required": true,
          "enum": [
            "navigate",
            "screenshot",
            "extract_text",
            "fill_form",
            "click"
          ]
        },
        "url": {
          "type": "string",
          "required": false
        },
        "selector": {
          "type": "string",
          "required": false
        },
        "value": {
          "type": "string",
          "required": false
        }
      },
      "outputs": {
        "result": {
          "type": "object"
        }
      },
      "errors": [
        "NAVIGATION_FAILED",
        "SELECTOR_NOT_FOUND",
        "TIMEOUT"
      ],
      "status": "available"
    },
    {
      "name": "catalog",
      "version": "0.4.0",
      "description": "Query the OSS capability matrix. Returns candidates filtered by capability and license.",
      "inputs": {
        "capability": {
          "type": "string",
          "required": false,
          "description": "filter by capability key (e.g., 'browser_operator')"
        },
        "license_only": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "required": false,
          "description": "filter by license SPDX (e.g., ['MIT', 'Apache-2.0'])"
        }
      },
      "outputs": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "errors": [
        "INVALID_CAPABILITY",
        "NO_MATCH"
      ],
      "status": "available"
    },
    {
      "name": "coding_agent",
      "version": "0.4.0",
      "description": "Execute coding tasks in a repository via aider subprocess. Handles file edits, bug fixes, and feature additions.",
      "inputs": {
        "task": {
          "type": "string",
          "required": true
        },
        "cwd": {
          "type": "string",
          "required": false,
          "description": "working directory for the aider subprocess"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "required": false,
          "description": "list of file paths to pass to aider"
        },
        "model": {
          "type": "string",
          "required": false
        },
        "timeout_s": {
          "type": "integer",
          "required": false,
          "default": 300
        }
      },
      "outputs": {
        "output": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      },
      "errors": [
        "AIDER_FAILED",
        "AIDER_NOT_INSTALLED",
        "TIMEOUT",
        "INVALID_INPUT"
      ],
      "status": "available"
    },
    {
      "name": "crawl4ai",
      "version": "0.4.0",
      "description": "Crawl a URL and return LLM-friendly markdown.",
      "inputs": {
        "url": {
          "type": "string",
          "required": true
        },
        "timeout_s": {
          "type": "integer",
          "required": false,
          "default": 30
        },
        "cache_mode": {
          "type": "string",
          "required": false,
          "default": "default",
          "enum": [
            "default",
            "bypass",
            "only"
          ]
        }
      },
      "outputs": {
        "markdown": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "links": {
          "type": "array"
        }
      },
      "errors": [
        "FETCH_FAILED",
        "TIMEOUT",
        "BLOCKED"
      ],
      "status": "available"
    },
    {
      "name": "deliverables",
      "version": "0.4.0",
      "description": "Generate deliverable artifacts in various formats.",
      "inputs": {
        "title": {
          "type": "string",
          "required": true
        },
        "sections": {
          "type": "array",
          "required": true
        },
        "table_data": {
          "type": "array",
          "required": false
        },
        "chart_spec": {
          "type": "object",
          "required": false
        },
        "formats": {
          "type": "array",
          "required": false,
          "default": [
            "md",
            "pdf",
            "xlsx",
            "pptx"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "outputs": {
        "artifacts": {
          "type": "array"
        }
      },
      "errors": [
        "INVALID_FORMAT",
        "WRITE_FAILED"
      ],
      "status": "available"
    },
    {
      "name": "docling",
      "version": "0.4.0",
      "description": "Parse a document at a given path into markdown using Docling.",
      "inputs": {
        "path": {
          "type": "string",
          "required": true,
          "description": "path to DOCX/PDF/HTML/etc., must be inside sandbox volume mount"
        },
        "max_chars": {
          "type": "integer",
          "required": false,
          "default": 100000
        }
      },
      "outputs": {
        "markdown": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "errors": [
        "FILE_NOT_FOUND",
        "OUTSIDE_ALLOWED_PATH",
        "PARSE_FAILED"
      ],
      "status": "available"
    },
    {
      "name": "image_gen",
      "version": "0.4.0",
      "description": "Generate an image via ComfyUI workflow.",
      "inputs": {
        "prompt": {
          "type": "string",
          "required": true
        },
        "style": {
          "type": "string",
          "required": false,
          "default": "photorealistic"
        },
        "aspect_ratio": {
          "type": "string",
          "required": false,
          "default": "16:9"
        },
        "reference_images": {
          "type": "array",
          "required": false,
          "items": {
            "type": "string"
          }
        }
      },
      "outputs": {
        "image_path": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "errors": [
        "COMFY_UNREACHABLE",
        "WORKFLOW_FAILED"
      ],
      "status": "available"
    },
    {
      "name": "mail",
      "version": "0.4.0",
      "description": "Send, list, and read email via Himalaya CLI. Supports IMAP/SMTP operations.",
      "inputs": {
        "operation": {
          "type": "string",
          "required": true,
          "enum": [
            "send",
            "list",
            "read"
          ]
        },
        "to": {
          "type": "string",
          "required": false
        },
        "subject": {
          "type": "string",
          "required": false
        },
        "body": {
          "type": "string",
          "required": false
        },
        "folder": {
          "type": "string",
          "required": false,
          "default": "INBOX"
        },
        "limit": {
          "type": "integer",
          "required": false,
          "default": 20
        },
        "message_id": {
          "type": "string",
          "required": false
        }
      },
      "outputs": {
        "status": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "errors": [
        "HIMALAYA_FAILED",
        "HIMALAYA_NOT_INSTALLED",
        "TIMEOUT",
        "INVALID_INPUT",
        "INVALID_OPERATION"
      ],
      "status": "available"
    },
    {
      "name": "memory",
      "version": "0.4.0",
      "description": "Persist and retrieve episodic memory via RASPUTIN MCP.",
      "inputs": {
        "operation": {
          "type": "string",
          "required": true,
          "enum": [
            "store",
            "retrieve",
            "search"
          ]
        },
        "content": {
          "type": "string",
          "required": false
        },
        "query": {
          "type": "string",
          "required": false
        },
        "memory_id": {
          "type": "string",
          "required": false
        },
        "k": {
          "type": "integer",
          "required": false,
          "default": 5
        }
      },
      "outputs": {
        "results": {
          "type": "array"
        }
      },
      "errors": [
        "MCP_UNREACHABLE",
        "INVALID_OPERATION"
      ],
      "status": "available"
    },
    {
      "name": "music_gen",
      "version": "0.4.0",
      "description": "Generate music via MusicGen-Melody.",
      "inputs": {
        "prompt": {
          "type": "string",
          "required": true
        },
        "duration_s": {
          "type": "number",
          "required": false,
          "default": 15
        }
      },
      "outputs": {
        "audio_path": {
          "type": "string"
        }
      },
      "errors": [
        "MODEL_UNAVAILABLE",
        "GENERATION_FAILED"
      ],
      "status": "deferred"
    },
    {
      "name": "sandbox",
      "version": "0.4.0",
      "description": "Execute code in agent-infra/sandbox.",
      "inputs": {
        "operation": {
          "type": "string",
          "required": true,
          "enum": [
            "code_execute",
            "jupyter_kernels_list",
            "file_upload",
            "file_download"
          ]
        },
        "code": {
          "type": "string",
          "required": false
        },
        "language": {
          "type": "string",
          "required": false,
          "enum": [
            "python",
            "bash",
            "node"
          ]
        },
        "file": {
          "type": "string",
          "required": false
        },
        "destination": {
          "type": "string",
          "required": false
        },
        "timeout_s": {
          "type": "integer",
          "required": false,
          "default": 60
        }
      },
      "outputs": {
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "artifacts": {
          "type": "array"
        }
      },
      "errors": [
        "SANDBOX_UNREACHABLE",
        "TIMEOUT",
        "INVALID_OPERATION"
      ],
      "status": "available"
    },
    {
      "name": "slides",
      "version": "0.4.0",
      "description": "Generate presentation slides from Markdown content using Marp CLI. Supports PDF, HTML, and PPTX output.",
      "inputs": {
        "markdown": {
          "type": "string",
          "required": true
        },
        "format": {
          "type": "string",
          "required": false,
          "enum": [
            "pdf",
            "html",
            "pptx"
          ],
          "default": "pdf"
        }
      },
      "outputs": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        }
      },
      "errors": [
        "MARP_FAILED",
        "MARP_NOT_INSTALLED",
        "TIMEOUT",
        "INVALID_INPUT",
        "INVALID_FORMAT"
      ],
      "status": "available"
    },
    {
      "name": "stt",
      "version": "0.4.0",
      "description": "Transcribe audio.",
      "inputs": {
        "audio_path": {
          "type": "string",
          "required": true
        },
        "language": {
          "type": "string",
          "required": false,
          "default": "auto"
        }
      },
      "outputs": {
        "transcript": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        }
      },
      "errors": [
        "FILE_NOT_FOUND",
        "MODEL_UNAVAILABLE",
        "TRANSCRIPTION_FAILED"
      ],
      "status": "available"
    },
    {
      "name": "tts",
      "version": "0.4.0",
      "description": "Synthesize speech from text.",
      "inputs": {
        "text": {
          "type": "string",
          "required": true
        },
        "voice": {
          "type": "string",
          "required": false,
          "default": "voxtral-female-1"
        },
        "format": {
          "type": "string",
          "required": false,
          "default": "wav",
          "enum": [
            "wav",
            "mp3"
          ]
        }
      },
      "outputs": {
        "audio_path": {
          "type": "string"
        },
        "duration_s": {
          "type": "number"
        }
      },
      "errors": [
        "MODEL_UNAVAILABLE",
        "SYNTHESIS_FAILED"
      ],
      "status": "available"
    },
    {
      "name": "video_gen",
      "version": "0.4.0",
      "description": "Generate a short video via Wan 2.1.",
      "inputs": {
        "prompt": {
          "type": "string",
          "required": true
        },
        "duration_s": {
          "type": "number",
          "required": false,
          "default": 5
        },
        "fps": {
          "type": "integer",
          "required": false,
          "default": 24
        }
      },
      "outputs": {
        "video_path": {
          "type": "string"
        }
      },
      "errors": [
        "GPU_OOM",
        "WAN_UNAVAILABLE",
        "GENERATION_FAILED"
      ],
      "status": "deferred"
    },
    {
      "name": "web_search",
      "version": "0.4.0",
      "description": "Search the web via SearXNG. Returns titles, URLs, and snippets for the given query.",
      "inputs": {
        "query": {
          "type": "string",
          "required": true
        },
        "max_results": {
          "type": "integer",
          "required": false,
          "default": 10
        },
        "categories": {
          "type": "string",
          "required": false,
          "default": "general"
        },
        "time_range": {
          "type": "string",
          "required": false,
          "enum": [
            "day",
            "week",
            "month",
            "year",
            ""
          ]
        },
        "language": {
          "type": "string",
          "required": false,
          "default": "en"
        }
      },
      "outputs": {
        "query": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "snippet": {
                "type": "string"
              }
            }
          }
        }
      },
      "errors": [
        "SEARXNG_UNREACHABLE",
        "TIMEOUT",
        "INVALID_INPUT"
      ],
      "status": "available"
    }
  ],
  "permissions": {
    "filesystem": [
      "read:./outputs",
      "write:./outputs"
    ],
    "network": [
      "egress:*"
    ],
    "subprocess": [
      "docker",
      "ffmpeg",
      "node",
      "npm"
    ]
  },
  "models_required": [
    "Qwen3-27B (OpenCode Zen)",
    "Claude Opus 4.7 (Anthropic API)"
  ]
}
