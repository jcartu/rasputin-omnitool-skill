{
  "name": "browser",
  "version": "0.5.0",
  "description": "Operate a browser via Playwright with persistent sessions.",
  "inputs": {
    "action": {
      "type": "string",
      "required": true,
      "enum": [
        "navigate",
        "screenshot",
        "extract_text",
        "fill_form",
        "click",
        "wait_for_selector",
        "evaluate"
      ]
    },
    "url": {
      "type": "string",
      "required": false
    },
    "selector": {
      "type": "string",
      "required": false
    },
    "value": {
      "type": "string",
      "required": false
    },
    "session_id": {
      "type": "string",
      "required": false
    },
    "goal_id": {
      "type": "string",
      "required": false
    },
    "headless": {
      "type": "boolean",
      "required": false,
      "default": true
    },
    "state": {
      "type": "string",
      "required": false,
      "enum": ["attached", "visible", "hidden", "detached"]
    },
    "timeout_ms": {
      "type": "integer",
      "required": false
    },
    "expression": {
      "type": "string",
      "required": false
    },
    "wait_for_selector": {
      "type": "string",
      "required": false
    },
    "wait_for_navigation": {
      "type": "boolean",
      "required": false,
      "default": true
    }
  },
  "outputs": {
    "result": {
      "type": "object",
      "properties": {
        "session_id": "string (when session-based)",
        "final_url": "string (navigate, click)",
        "title": "string (navigate, screenshot)",
        "status": "integer (navigate)",
        "path": "string (screenshot)",
        "text": "string (extract_text)",
        "result": "any (evaluate)",
        "found": "boolean (wait_for_selector)"
      }
    }
  },
  "tags": ["web", "automation", "interactive", "session-aware"],
  "errors": [
    "NAVIGATION_FAILED",
    "SELECTOR_NOT_FOUND",
    "TIMEOUT",
    "SESSION_NOT_FOUND",
    "SESSION_DEAD"
  ]
}
