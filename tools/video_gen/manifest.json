{
  "name": "video_gen",
  "version": "0.4.0",
  "description": "Generate a short video via Wan 2.1.",
  "inputs": {
    "prompt": {
      "type": "string",
      "required": true
    },
    "duration_s": {
      "type": "number",
      "required": false,
      "default": 5
    },
    "fps": {
      "type": "integer",
      "required": false,
      "default": 24
    }
  },
  "outputs": {
    "video_path": {
      "type": "string"
    }
  },
  "errors": [
    "GPU_OOM",
    "WAN_UNAVAILABLE",
    "GENERATION_FAILED"
  ],
  "status": "deferred",
  "deferred_reason": "Wan 2.1 requires dedicated GPU with 96GB VRAM; no live endpoint available for sprint verification. See BACKLOG.md."
}
