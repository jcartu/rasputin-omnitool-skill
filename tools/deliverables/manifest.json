{
  "name": "deliverables",
  "version": "0.4.0",
  "description": "Generate deliverable artifacts in various formats.",
  "inputs": {
    "title": {
      "type": "string",
      "required": true
    },
    "sections": {
      "type": "array",
      "required": true
    },
    "table_data": {
      "type": "array",
      "required": false
    },
    "chart_spec": {
      "type": "object",
      "required": false
    },
    "formats": {
      "type": "array",
      "required": false,
      "default": [
        "md",
        "pdf",
        "xlsx",
        "pptx"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "outputs": {
    "artifacts": {
      "type": "array"
    }
  },
  "errors": [
    "INVALID_FORMAT",
    "WRITE_FAILED"
  ]
}
