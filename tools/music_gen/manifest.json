{
  "name": "music_gen",
  "version": "0.4.0",
  "description": "Generate music via MusicGen-Melody.",
  "inputs": {
    "prompt": {
      "type": "string",
      "required": true
    },
    "duration_s": {
      "type": "number",
      "required": false,
      "default": 15
    }
  },
  "outputs": {
    "audio_path": {
      "type": "string"
    }
  },
  "tags": ["media", "audio", "generation"],
  "errors": [
    "MODEL_UNAVAILABLE",
    "GENERATION_FAILED"
  ],
  "status": "deferred",
  "deferred_reason": "audiocraft/MusicGen requires heavy torch/torchaudio dependencies; separate venv needed. See BACKLOG.md.",
  "backends": [
    {
      "name": "musicgen",
      "health_url": "http://localhost:8811/health",
      "required": true
    }
  ],
  "requires_compose_profile": "gpu-multi"
}
